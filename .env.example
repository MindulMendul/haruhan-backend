# caddy(리버스 프록시)가 HTTPS 인증서를 발급받을 도메인.
# docker-compose.yml의 caddy 서비스에서만 쓰임 (앱 자체는 이 값을 안 읽음).
DOMAIN=api.example.com

# Grafana 관리자 계정 비밀번호. docker-compose.yml의 grafana 서비스에서만 쓰임
# (앱 자체는 이 값을 안 읽음). 기본 admin/admin으로 뜨는 걸 막기 위해 필수값으로 뒀다.
GRAFANA_ADMIN_PASSWORD=

# Supabase/PostgreSQL 연결 문자열 (미설정 시 DB 관련 기능은 비활성화됨)
DATABASE_URL=postgresql://user:password@host:5432/dbname

# Ollama 엔진 base URL
OLLAMA_BASE_URL=http://localhost:11434

# 콤마로 구분된 허용 origin 목록. 비우면 모든 cross-origin 요청이 차단됨.
CORS_ORIGINS=https://example.com,https://app.example.com

# /api/chat 인증용 키. 미설정 시 인증이 비활성화되므로 운영 환경에서는 반드시 설정할 것.
API_KEY=

# LLM 호출 엔드포인트(chat/study/quiz/interview) 공통 레이트 리밋
# (limits 라이브러리 문법: "10/minute", "100/hour" 등)
CHAT_RATE_LIMIT=10/minute

# 로그인/회원가입/프로필수정처럼 브루트포스 대상이 될 수 있는 엔드포인트용 제한
AUTH_RATE_LIMIT=5/minute

# 모델 목록 조회(/models, 이 앱에서 유일하게 인증 없이 공개된 엔드포인트)용 제한.
# 60초 캐시가 있어 LLM 호출 엔드포인트보다 넉넉하게 잡는다.
MODELS_RATE_LIMIT=30/minute

# prompt/메시지 최대 길이 (문자 수)
MAX_PROMPT_LENGTH=4000

# 학습챗이 매 메시지마다 Ollama에 다시 실어 보내는 대화 히스토리를 가장 최근
# 이 개수만큼으로 제한한다 (대화가 길어질수록 프롬프트가 무한정 커지는 것을 방지)
MAX_CHAT_HISTORY_MESSAGES=40

# 퀴즈 생성 소스 텍스트 최대 길이 (문자 수)
MAX_QUIZ_SOURCE_LENGTH=20000
DEFAULT_QUIZ_QUESTION_COUNT=5
MAX_QUIZ_QUESTION_COUNT=20

# 면접 연습 세션 하나당 최대 질문 수
MAX_INTERVIEW_QUESTIONS=5

# 면접 복기 content 최대 길이 (문자 수)
MAX_REVIEW_CONTENT_LENGTH=10000

# 학습챗 RAG 검색용 임베딩 모델. Ollama에 별도로 pull 되어 있어야 한다 (예: ollama pull nomic-embed-text).
EMBEDDING_MODEL=nomic-embed-text
# 학습챗 답변 생성 시 참고자료로 첨부할 최대 청크 개수
RAG_TOP_K=3
# 코사인 유사도 채점 대상 후보 청크 수 상한 (최근 것부터). 정상적인 사용량보다
# 훨씬 크게 잡아둔 안전장치일 뿐, 극단적으로 계정이 커지지 않는 한 영향 없음.
RAG_MAX_CANDIDATE_CHUNKS=2000

# WebSocket 스트리밍(학습챗/면접복기)이 클라이언트로부터 다음 메시지를 이
# 시간(초) 안에 못 받으면 연결을 끊는다 (방치된 연결의 DB 커넥션 풀 고갈 방지)
WS_IDLE_TIMEOUT_SECONDS=300

# 요청 바디 최대 크기 (바이트). 기본 1MB.
MAX_BODY_SIZE_BYTES=1048576

# 설정하면 레이트 리밋이 Redis를 공유 스토리지로 사용한다 (다중 워커/인스턴스 배포용).
# 앱을 직접 실행할 때 비워두면 인메모리 스토리지를 쓴다 (단일 프로세스 한정으로만 정확함).
# docker-compose로 배포할 때는 비워둬도 docker-compose.yml이 내장 redis 서비스
# (redis://redis:6379/0)를 기본값으로 채워 넣는다 - 외부 관리형 Redis를 쓰려면
# 여기에 그 접속 문자열을 직접 채워서 기본값을 덮어쓰면 된다.
REDIS_URL=

# JWT 서명 키. 필수값이라 설정하지 않으면 앱이 시작되지 않는다.
# 생성: openssl rand -hex 32  (32자 미만이면 앱 시작 자체가 거부된다 - 취약한 시크릿 방지)
JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=14

# DEBUG/INFO/WARNING/ERROR/CRITICAL 중 하나 (대소문자 무관, 자동으로 대문자 정규화됨).
# 그 외 값이면 시작 시 바로 거부된다.
LOG_LEVEL=INFO
# production으로 설정하면 /docs, /redoc, /openapi.json이 비활성화된다.
# development/production 둘 중 하나여야 하며(대소문자 무관), 그 외 값(예: prod)은
# 시작 시 바로 거부된다 - 오타로 조용히 "production"과 안 맞아 프로덕션에서도
# 문서가 계속 열려 있게 되는 사고를 막기 위함이다.
ENVIRONMENT=development
